# MyQ Garage Door Controller — configuration
# Copy to .env and fill in. .env is gitignored; never commit real values.

# ============================================
# API security  (REQUIRED)
# ============================================
# Protects every door endpoint. If this is empty the API refuses all requests
# rather than running open — an unauthenticated URL that opens a garage door
# is not a safe default.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ============================================
# MyQ account  (only used by `myq login`)
# ============================================
# The deployed API never uses these — it only ever uses stored OAuth tokens.
MYQ_EMAIL=
MYQ_PASSWORD=

# ============================================
# Token storage
# ============================================
# "file" for local development, "ssm" for the AWS deployment.
TOKEN_STORE=file
SSM_PARAMETER=/myq/tokens
AWS_REGION=us-east-1

# ============================================
# Local server (ignored on Lambda)
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# Tuning (optional — defaults are sensible)
# ============================================
# DEVICE_CACHE_TTL=10
# COMMAND_WAIT_TIMEOUT=25
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW=60
